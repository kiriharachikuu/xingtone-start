# 默认管理员密码，部署时务必修改
ADMIN_PASSWORD=xingtone-admin

# 后端 API 地址（官网公共版本接口 /public/app-versions 数据源，末尾含 /api）
XT_API_BASE=https://xtmusicapi.chikuu.top/api

# 站点内容存储驱动（后台「修改官网内容」的持久化方式）
# - 留空（默认）：生产环境自动使用 EdgeOne Blob 持久化，本地开发自动使用本地文件 data/site.json
# - blob：强制使用 EdgeOne Blob（需部署在 EdgeOne Cloud Functions，运行时自动鉴权，
#         命名空间首次访问自动创建，无需控制台开通，区别于需审批的 KV）
# - fs：强制使用本地文件 data/site.json（仅适合本地开发，EdgeOne 上文件系统不持久）
STORAGE_DRIVER=
